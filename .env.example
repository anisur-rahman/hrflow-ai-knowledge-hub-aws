# ---- Local development (docker compose) ----
ENVIRONMENT=local
POSTGRES_PASSWORD=hrflow_dev
AWS_REGION=us-east-1
LOG_LEVEL=INFO

# mock = offline demo (no AWS). bedrock = real Titan embeddings + Converse chat model.
AI_PROVIDER=mock
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# local = files on a Docker volume, processed in the API process.
# AWS deployments set s3 + INGESTION_QUEUE_URL + OCR_PROVIDER=textract (see infra/terraform).
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=/app/uploads
OCR_PROVIDER=none

# Local auth: one API key whose holder gets these groups. AWS uses AUTH_MODE=cognito.
AUTH_MODE=apikey
API_KEY=local-demo-key-change-me
API_KEY_GROUPS=hr-admin,employee
KNOWN_GROUPS=employee,hr-admin
DEFAULT_DOCUMENT_GROUPS=employee
CORS_ORIGINS=http://localhost:5173
